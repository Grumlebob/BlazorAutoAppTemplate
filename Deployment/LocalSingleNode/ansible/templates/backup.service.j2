[Unit]
Description=Protected {{ app_name }} PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=deploy
Group={{ install_group }}
UMask=0027
ExecStart=/bin/bash {{ deploy_root }}/maintenance/Common/Scripts/with-deploy-lock.sh python3 {{ deploy_root }}/maintenance/lib/backup.py --config {{ deploy_root }}/maintenance/settings.json
TimeoutStartSec=600
