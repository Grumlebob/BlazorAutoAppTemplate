APP_NAME={{ app_name }}
APP_IMAGE_REF={{ app_image }}@{{ release_image_digest }}
APP_VERSION={{ app_version }}
APP_PORT={{ app_port }}
POSTGRES_PORT={{ postgres_port }}
REDIS_PORT={{ redis_port }}
POSTGRES_DB={{ app_name | replace('-', '_') }}
POSTGRES_USER={{ app_name | replace('-', '_') }}
POSTGRES_PASSWORD={{ vault_postgres_password }}
REDIS_PASSWORD={{ vault_redis_password }}
DOCKER_SUBNET={{ docker_subnet }}
Accounts__Enabled={{ accounts_enabled | default(false) | string | lower }}
Accounts__RegistrationEnabled={{ accounts_registration_enabled | default(false) | string | lower }}
Accounts__AdminSeed__Enabled={{ accounts_admin_seed_enabled | default(false) | string | lower }}
Accounts__AdminSeed__Email={{ accounts_admin_seed_email | default('') }}
Accounts__AdminSeed__Password={{ vault_accounts_admin_seed_password | default('') }}
Accounts__PublicOrigin={{ accounts_public_origin | default('') }}
Accounts__Email__Host={{ accounts_email_host | default('') }}
Accounts__Email__Port={{ accounts_email_port | default(587) }}
Accounts__Email__Security={{ accounts_email_security | default('StartTls') }}
Accounts__Email__From={{ accounts_email_from | default('') }}
Accounts__Email__Username={{ vault_accounts_email_username | default('') }}
Accounts__Email__Password={{ vault_accounts_email_password | default('') }}
DataProtection__KeyEncryptionCertificatePath=/run/secrets/data-protection.pem
DataProtection__KeyEncryptionCertificatePassword={{ vault_data_protection_certificate_password }}
DataProtection__LegacyKeyStore={{ data_protection_legacy_key_store | default('None') }}
DataProtection__LegacyRedisKey={{ data_protection_legacy_redis_key | default('') }}
DataProtection__LegacyKeyStoragePath={{ '/run/legacy-data-protection' if (data_protection_legacy_key_store | default('None')) == 'FileSystem' else '' }}
