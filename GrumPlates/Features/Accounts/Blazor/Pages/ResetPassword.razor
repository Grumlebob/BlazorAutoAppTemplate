@page "/Account/ResetPassword"

@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities

@inject IdentityRedirectManager RedirectManager
@inject UserManager<ApplicationUser> UserManager
@inject AccountOptions AccountOptions
@inject AccountOperations Accounts
@inject IHttpContextAccessor HttpContextAccessor

<PageTitle>Reset password</PageTitle>

<h1>Reset password</h1>
<h2>Reset your password.</h2>
<hr class="account-divider" />
<StatusMessage Message="@Message" />
@if (AccountOptions.Enabled && !AccountOptions.EmailEnabled)
{
    <p role="status">This account operation is unavailable.</p>
}
else
{
    <div class="account-grid">
        <div class="account-grid-main">
            <EditForm Model="Input" FormName="reset-password" OnValidSubmit="OnValidSubmitAsync" method="post">
                <DataAnnotationsValidator />
                <ValidationSummary class="account-text-danger" role="alert" />

                <input type="hidden" name="Input.Code" value="@Input.Code" />
                @if (AccountOptions.Enabled)
                {
                    <input type="hidden" name="Input.UserId" value="@Input.UserId" />
                }
                else
                {
                    <div class="account-field">
                        <InputText @bind-Value="Input.Email" id="Input.Email" class="account-input" autocomplete="username" maxlength="254" aria-required="true" placeholder="name@example.com" />
                        <label for="Input.Email" class="account-label">Email</label>
                        <ValidationMessage For="() => Input.Email" class="account-text-danger" />
                    </div>
                }
                <div class="account-field">
                    <InputText type="@(showPasswords ? "text" : "password")" @bind-Value="Input.Password" id="Input.Password" class="account-input" autocomplete="new-password" maxlength="256" aria-required="true" placeholder="Please enter your password." />
                    <label for="Input.Password" class="account-label">Password</label>
                    <ValidationMessage For="() => Input.Password" class="account-text-danger" />
                </div>
                <div class="account-field">
                    <InputText type="@(showPasswords ? "text" : "password")" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="account-input" autocomplete="new-password" maxlength="256" aria-required="true" placeholder="Please confirm your password." />
                    <label for="Input.ConfirmPassword" class="account-label">Confirm password</label>
                    <ValidationMessage For="() => Input.ConfirmPassword" class="account-text-danger" />
                </div>
                @if (AccountOptions.Enabled)
                {
                    <p class="account-muted">Use 15–128 Unicode characters. Avoid common or app-related passwords.</p>
                }
                <label><InputCheckbox @bind-Value="showPasswords" /> Show passwords</label>
                <button type="submit" class="account-button-primary account-button-full">Reset</button>
            </EditForm>
        </div>
    </div>
}

@code {
    private string? message;
    private bool showPasswords;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    private string? Message => message;

    protected override void OnInitialized()
    {
        Input ??= new();
        Input.SetAccountPasswordPolicy(AccountOptions.Enabled);

        if (Code is null)
        {
            RedirectManager.RedirectTo("Account/InvalidPasswordReset");
            return;
        }

        try
        {
            Input.Code = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
            Input.UserId = UserId ?? "";
        }
        catch (FormatException)
        {
            RedirectManager.RedirectTo("Account/InvalidPasswordReset");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (AccountOptions.Enabled)
        {
            var requestContext = HttpContextAccessor.HttpContext;
            if (requestContext is null || string.IsNullOrEmpty(Input.UserId))
            {
                RedirectManager.RedirectTo("Account/InvalidPasswordReset");
                return;
            }

            var response = await AccountPageResultReader.ReadAsync(requestContext,
                await Accounts.ResetForBlazorAsync(new AccountResetPasswordRequest
                {
                    UserId = Input.UserId,
                    Token = Input.Code,
                    NewPassword = Input.Password
                }));
            if (response.StatusCode == StatusCodes.Status200OK)
            {
                RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
                return;
            }

            message = AccountPageResultReader.Message(response.Body, "The reset link is invalid or the password was rejected.");
            return;
        }

        if (string.IsNullOrWhiteSpace(Input.Email))
        {
            message = "Enter the email address for the account.";
            return;
        }

        var user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            // Don't reveal that the user does not exist
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        var result = await UserManager.ResetPasswordAsync(user, Input.Code, Input.Password);
        if (result.Succeeded)
        {
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
            return;
        }

        message = "Unable to reset your password. Request a new reset link and try again.";
    }

    private sealed class InputModel : AccountPasswordPolicyInputModel
    {
        [EmailAddress]
        public string? Email { get; set; }

        [StringLength(128)]
        public string UserId { get; set; } = "";

        [Required]
        [AccountPasswordLength]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm password")]
        [Compare("Password", ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";

        [Required]
        public string Code { get; set; } = "";
    }
}
