@page "/Account/ForgotPasswordConfirmation"

@inject AccountOptions AccountOptions

<PageTitle>Forgot password confirmation</PageTitle>

<h1>Forgot password confirmation</h1>
<p role="alert">
    @if (AccountOptions.Enabled)
    {
        <text>Request received. Check your email if applicable; use resend if it does not arrive.</text>
    }
    else
    {
        <text>Please check your email to reset your password.</text>
    }
</p>
