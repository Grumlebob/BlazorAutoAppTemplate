@implements IDisposable

@inject IBooksApi Books
@inject IAuthorBooksApi AuthorBooks
@inject NavigationManager Nav
@inject UserBookcaseState UserBooks
@inject Microsoft.Extensions.Logging.ILogger<BookModalHost> Logger

@if (_lifecycle.Request is not null)
{
    <div @ref="_dialog"
         class="fixed inset-0 z-50 overflow-y-auto bg-transparent px-4 py-6 outline-none"
         role="dialog"
         aria-modal="true"
         aria-labelledby="book-modal-title"
         tabindex="-1"
         data-testid="book-modal"
         @onkeydown="HandleKeyDown">
        <div class="mx-auto flex min-h-full w-[min(calc(100vw-2rem),37rem)] flex-col items-center justify-start">
            @if (_lifecycle.Loading)
            {
                <div class="w-full rounded-md border border-gray-200 bg-white px-4 py-3 text-sm font-medium text-gray-700 shadow-sm">
                    Loading book...
                </div>
            }
            else if (_lifecycle.Request.Mode is BookModalMode.View && _lifecycle.ViewModel is not null)
            {
                <h1 id="book-modal-title" class="sr-only">@_lifecycle.ViewModel.Title</h1>
                <BookPageView Title="@_lifecycle.ViewModel.Title"
                              Author="@_lifecycle.ViewModel.Author"
                              Url="@_lifecycle.ViewModel.Url"
                              EditHref="@UserEditHref"
                              CloseHref="/books"
                              CanDelete="@_lifecycle.CanDelete"
                              IsDeleteConfirming="@_lifecycle.ConfirmingDelete"
                              IsDeleteBusy="@_lifecycle.Deleting"
                              OnDeleteRequest="RequestDelete"
                              OnDeleteConfirm="DeleteAsync"
                              OnDeleteCancel="CancelDelete" />
                @if (_lifecycle.Error is not null)
                {
                    <p data-testid="book-operation-error"
                       class="mt-4 w-full rounded-md border border-red-200 bg-white px-4 py-3 text-sm font-medium text-red-700 shadow-sm"
                       role="alert">@_lifecycle.Error</p>
                }
            }
            else if (_lifecycle.Error is not null)
            {
                <div class="w-full rounded-md border border-red-200 bg-white px-4 py-3 text-sm font-medium text-red-700 shadow-sm">
                    <div class="mb-2 flex justify-end">
                        <a data-testid="book-back"
                           class="inline-flex items-center rounded-md border border-red-200 bg-white px-3 py-2 text-sm font-bold text-red-700 no-underline shadow-sm hover:bg-red-50 hover:text-red-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
                           href="/books">Close</a>
                    </div>
                    <h1 id="book-modal-title" class="mb-1 text-lg font-bold text-red-700">Book not found.</h1>
                    <p>@_lifecycle.Error</p>
                </div>
            }
            else if (_lifecycle.Request.Mode is BookModalMode.Create or BookModalMode.Edit)
            {
                <h1 id="book-modal-title" class="sr-only">@EditorHeading</h1>
                <BookPageEditor Model="_lifecycle.EditorModel"
                                Heading="@EditorHeading"
                                SubmitLabel="Close and save"
                                CancelLabel="Close"
                                CancelHref="/books"
                                Error="@_lifecycle.SaveError"
                                IsBusy="@_lifecycle.Saving"
                                OnValidSubmit="SaveAsync" />
            }
        </div>
    </div>
}

@code {
    private ElementReference _dialog;
    private BookModalLifecycle _lifecycle = default!;
    private bool _focusPending;

    [CascadingParameter]
    private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private string? UserEditHref =>
        _lifecycle.Request is { Source: BookModalSource.User, Mode: BookModalMode.View, UserBookId: not null }
            ? $"/books?bookId={_lifecycle.Request.UserBookId.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}&bookMode=edit"
            : null;

    private string EditorHeading => _lifecycle.Request?.Mode is BookModalMode.Create ? "Add Book" : "Edit Book";

    protected override async Task OnInitializedAsync()
    {
        _lifecycle = new BookModalLifecycle(Books, AuthorBooks, UserBooks, Logger,
            (uri, forceLoad) => Nav.NavigateTo(uri, forceLoad));
        _lifecycle.Changed += HandleLifecycleChanged;
        Nav.LocationChanged += HandleLocationChanged;
        await LoadFromUriAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusPending && _lifecycle.Request is not null)
        {
            _focusPending = false;
            await _dialog.FocusAsync();
        }
    }

    private void HandleLifecycleChanged() => _ = InvokeAsync(StateHasChanged);

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs args) =>
        _ = InvokeAsync(LoadFromUriAsync);

    private Task LoadFromUriAsync()
    {
        var uri = Nav.Uri;
        var request = BookModalRouteState.Parse(uri);
        if (request is not null) _focusPending = true;
        return _lifecycle.LoadAsync(request, AuthenticationStateTask, uri);
    }

    private Task SaveAsync(BookPageEditorModel model) => _lifecycle.SaveAsync(model);

    private Task DeleteAsync() => _lifecycle.DeleteAsync();

    private void RequestDelete() => _lifecycle.RequestDelete();

    private void CancelDelete() => _lifecycle.CancelDelete();

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") Nav.NavigateTo("/books");
    }

    public void Dispose()
    {
        Nav.LocationChanged -= HandleLocationChanged;
        _lifecycle.Changed -= HandleLifecycleChanged;
        _lifecycle.Dispose();
    }
}
