<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RuntimeIdentifiers>linux-x64</RuntimeIdentifiers>
    <RequiresAspNetWebAssets Condition="'$(FrontendProfile)' == 'BlazorAuto'">true</RequiresAspNetWebAssets>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
    <ProjectReference Include="..\BlazorAutoApp.Core\BlazorAutoApp.Core.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.StackExchangeRedis" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="Npgsql.OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
    <Content Update="settings.defaults.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(FrontendProfile)' == 'BlazorAuto'">
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    <ProjectReference Include="..\BlazorAutoApp.Client\BlazorAutoApp.Client.csproj" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Frontend/FrontendComposition.BlazorAuto.cs" Condition="'$(FrontendProfile)' != 'BlazorAuto'" />
    <Compile Remove="Frontend/FrontendComposition.React.cs" Condition="'$(FrontendProfile)' != 'React'" />
  </ItemGroup>
  <PropertyGroup Condition="'$(FrontendProfile)' == 'React'">
    <EnableDefaultRazorComponentItems>false</EnableDefaultRazorComponentItems>
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
  </PropertyGroup>
  <ItemGroup Condition="'$(FrontendProfile)' == 'React'">
    <Content Remove="**/*.razor" />
    <None Remove="**/*.razor.js" />
    <Compile Remove="Features/Login/Account/IdentityComponentsEndpointRouteBuilderExtensions.cs" />
    <Compile Remove="Features/Login/Account/BlazorIdentityServiceCollectionExtensions.cs" />
    <Content Remove="wwwroot/**/*" />
    <Content Include="wwwroot/favicon.png">
      <TargetPath>wwwroot/favicon.png</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Frontend/React/wwwroot/**/*">
      <Link>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <TargetPath>wwwroot/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="PrepareFrontendPublishWebRoot" BeforeTargets="ComputeFilesToPublish" Condition="'$(FrontendProfile)' == 'React' Or '$(FrontendProfile)' == 'BlazorAuto'">
    <PropertyGroup>
      <_ReactPublishWebRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(PublishDir)', 'wwwroot'))</_ReactPublishWebRoot>
      <_ReactSourceWebRoot>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', 'wwwroot'))</_ReactSourceWebRoot>
    </PropertyGroup>
    <Error Condition="'$(_ReactPublishWebRoot)' == '$(_ReactSourceWebRoot)'" Text="Frontend publish output cannot be the source wwwroot directory." />
    <RemoveDir Directories="$(_ReactPublishWebRoot)" Condition="Exists('$(_ReactPublishWebRoot)')" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Enrichers.Environment" />
    <PackageReference Include="Serilog.Sinks.Console" />
  </ItemGroup>
</Project>
