@page "/Account/Manage/SetPassword"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject AccountOptions AccountOptions

<PageTitle>Set password</PageTitle>

<h3>Set your password</h3>
<StatusMessage Message="@message" />
<p class="account-muted">
    You do not have a local username/password for this site. Add a local
    account so you can log in without an external login.
</p>
<div class="account-grid">
    <div class="account-grid-main">
        <EditForm Model="Input" FormName="set-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="account-text-danger" role="alert" />
            <div class="account-field">
                <InputText type="@(showPasswords ? "text" : "password")" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="account-input" autocomplete="new-password" maxlength="@(AccountOptions.Enabled ? "256" : null)" placeholder="Enter the new password" />
                <label for="Input.NewPassword" class="account-label">New password</label>
                <ValidationMessage For="() => Input.NewPassword" class="account-text-danger" />
            </div>
            <div class="account-field">
                <InputText type="@(showPasswords ? "text" : "password")" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="account-input" autocomplete="new-password" maxlength="@(AccountOptions.Enabled ? "256" : null)" placeholder="Enter the new password" />
                <label for="Input.ConfirmPassword" class="account-label">Confirm password</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="account-text-danger" />
            </div>
            @if (AccountOptions.Enabled)
            {
                <p class="account-muted">Use 15–128 Unicode characters. Avoid common or app-related passwords.</p>
            }
            <label><InputCheckbox @bind-Value="showPasswords" /> Show passwords</label>
            <button type="submit" class="account-button-primary account-button-full">Set password</button>
        </EditForm>
     </div>
</div>

@code {
    private string? message;
    private ApplicationUser? user;
    private bool showPasswords;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        Input.SetAccountPasswordPolicy(AccountOptions.Enabled);

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var hasPassword = await UserManager.HasPasswordAsync(user);
        if (AccountOptions.Enabled && !hasPassword)
        {
            RedirectManager.RedirectTo("Account/Login");
            return;
        }
        if (hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/ChangePassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var addPasswordResult = await UserManager.AddPasswordAsync(user, Input.NewPassword!);
        if (!addPasswordResult.Succeeded)
        {
            message = "Unable to set your password. Review the password requirements and try again.";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus("Your password has been set.", HttpContext);
    }

    private sealed class InputModel : AccountPasswordPolicyInputModel
    {
        [Required]
        [AccountPasswordLength]
        [DataType(DataType.Password)]
        [Display(Name = "New password")]
        public string? NewPassword { get; set; }

        [DataType(DataType.Password)]
        [Display(Name = "Confirm new password")]
        [Compare("NewPassword", ErrorMessage = "The new password and confirmation password do not match.")]
        public string? ConfirmPassword { get; set; }
    }
}
