<Project>
  <PropertyGroup>
    <FrontendProfileFromEnvironment>$([System.Environment]::GetEnvironmentVariable('FrontendProfile'))</FrontendProfileFromEnvironment>
    <FrontendProfileFromEnvironment Condition="'$(FrontendProfileFromEnvironment)' == ''">$([System.Environment]::GetEnvironmentVariable('FRONTENDPROFILE'))</FrontendProfileFromEnvironment>
    <FrontendProfileFromEnvironment Condition="'$(FrontendProfileFromEnvironment)' == ''">$([System.Environment]::GetEnvironmentVariable('frontendprofile'))</FrontendProfileFromEnvironment>
    <FrontendProfile Condition="'$(FrontendProfile)' == '' and Exists('$(MSBuildThisFileDirectory)frontend-profile.txt')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)frontend-profile.txt').Trim())</FrontendProfile>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RunSonarAnalyzers)' == 'true'">
    <SonarErrorLogDirectory Condition="'$(SonarErrorLogDirectory)' == ''">$(BaseIntermediateOutputPath)sonar-sarif/</SonarErrorLogDirectory>
    <ErrorLog>$(SonarErrorLogDirectory)$(MSBuildProjectName).sarif,version=2.1</ErrorLog>
  </PropertyGroup>

  <ItemGroup Condition="'$(RunSonarAnalyzers)' == 'true'">
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" />
  </ItemGroup>
</Project>
