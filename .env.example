############################################
# Local Docker environment for BlazorAutoApp
#
# Copy this file to .env and keep .env uncommitted. Start the local stack with
# Scripts/RunLocal.ps1; it supplies only Compose interpolation inputs and leaves
# the raw account values for the web container's format: raw env_file.
############################################

App__Name=BlazorAutoApp
App__Url=https://localhost:7186
APP_NODE_NAME=local-web

# Host-side ports used by docker-compose.yml. Change these when your
# machine already has one of the defaults in use.
APP_HTTPS_HOST_PORT=7186
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
REDIS_INSIGHT_HOST_PORT=5540
GRAFANA_HOST_PORT=3000
ALERTMANAGER_HOST_PORT=9093
PROMETHEUS_HOST_PORT=9090
LOKI_HOST_PORT=3100
TEMPO_HOST_PORT=3200
ALLOY_HOST_PORT=12345
POSTGRES_EXPORTER_HOST_PORT=9187
REDIS_EXPORTER_HOST_PORT=9121

# PostgreSQL container and app database connection.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=app

Database__Host=postgres
Database__Port=5432
Database__Name=app
Database__Username=postgres
Database__Password=postgres

# Redis.
Redis__Configuration=redis:6379

# OpenTelemetry is off by default. Later observability phases enable this
# after a local Alloy collector exists.
Observability__OpenTelemetry__Enabled=false
Observability__OpenTelemetry__Endpoint=http://alloy:4317
Observability__OpenTelemetry__Protocol=Grpc
Observability__OpenTelemetry__TraceSampleRatio=0.1
Observability__OpenTelemetry__DeploymentTarget=local
Observability__OpenTelemetry__NodeName=local-web
OBSERVABILITY_ENABLED=false
OBSERVABILITY_OTLP_ENDPOINT=http://alloy:4317
OBSERVABILITY_OTLP_PROTOCOL=Grpc
OBSERVABILITY_TRACE_SAMPLE_RATIO=1.0
OBSERVABILITY_DEPLOYMENT_TARGET=local

# Optional React email/password accounts. Disabled by default.
# Admin seeding creates once; it never resets an existing account password.
# Fill credentials only in your ignored .env, then disable seeding after setup.
# Account values are read as raw KEY=value strings. Leave them unquoted; spaces,
# $, #, quotes and additional = characters are preserved. Newlines are unsupported.
Accounts__Enabled=false
Accounts__RegistrationEnabled=false
Accounts__AdminSeed__Enabled=false
Accounts__AdminSeed__Email=
Accounts__AdminSeed__Password=
# Optional SMTP enables confirmation/recovery; self-registration also needs
# Accounts__RegistrationEnabled=true. PublicOrigin is the frontend HTTPS origin.
Accounts__PublicOrigin=
Accounts__Email__Host=
Accounts__Email__Port=587
Accounts__Email__Security=StartTls
Accounts__Email__From=
Accounts__Email__Username=
Accounts__Email__Password=

# Existing Blazor-only optional Google configuration.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
