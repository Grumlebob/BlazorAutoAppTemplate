{
  "name": "blazor-auto-app-react",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@12.2.0",
  "engines": {
    "node": "24.21.0",
    "npm": "12.2.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite --host localhost",
    "dev:api": "node scripts/dev-api.mjs",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "eslint app scripts vite.config.ts vitest.config.ts react-router.config.ts eslint.config.js",
    "test": "vitest run",
    "build": "npm run typecheck && react-router build",
    "api:generate": "node scripts/openapi-contract.mjs generate",
    "api:check": "node scripts/openapi-contract.mjs check",
    "api:typegen": "openapi-typescript"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router": "8.4.0",
    "isbot": "5.2.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-router/dev": "8.4.0",
    "@react-router/node": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "jsdom": "30.1.2",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
